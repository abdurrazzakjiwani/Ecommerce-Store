# ---------------------------------------------------------------------------
# COPY THIS FILE TO `.env` AND FILL IN THE VALUES. NEVER COMMIT `.env`.
# Every key below is required unless marked optional.
# ---------------------------------------------------------------------------

# --- Database (Neon, POOLED connection string) ------------------------------
# Get this from the Neon console. Use the pooled URI, not the direct one.
DATABASE_URI=

# --- Payload auth -----------------------------------------------------------
# Generate with: openssl rand -base64 32
# Losing this invalidates every admin session and all signed payloads.
PAYLOAD_SECRET=

# --- Public URL -------------------------------------------------------------
# The origin the app is served from. Used for absolute URLs and metadata.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email (Resend) ---------------------------------------------------------
# Note: leaving RESEND_API_KEY empty makes Payload fall back to an ephemeral
# development mail service that prints credentials to the console. That is NOT
# real delivery. See specs/001-whatsapp-storefront/research.md decision D9.
RESEND_API_KEY=
RESEND_FROM=

# --- Media storage (S3-compatible: Vercel Blob) -----------------------------
# MANDATORY. Vercel's local disk does not survive a redeploy, so local storage
# means client product images are silently lost. See research.md decision D4.
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
AWS_REGION=auto

# --- Uploads ----------------------------------------------------------------
# Vercel caps proxied server-side uploads at 4.5MB. Modern phone photos exceed
# that, so client-direct upload must stay enabled. Requires CORS to allow PUT
# from the site origin on the bucket. See quickstart.md Step 3.
S3_UPLOAD_MAX_SIZE=10485760
